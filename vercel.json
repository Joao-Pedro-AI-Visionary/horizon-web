{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/item-page.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/items/:id(\\d+)", "destination": "/api/item-page?id=:id" },
    { "source": "/og/items/:id(\\d+).png", "destination": "/api/seo-proxy?kind=og&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/seo-proxy?kind=sitemap" },
    { "source": "/rss.xml", "destination": "/api/seo-proxy?kind=rss-feed" },
    { "source": "/digests/rss.xml", "destination": "/api/seo-proxy?kind=rss-digests" },
    {
      "source": "/((?!assets/|api/|robots\\.txt|sitemap\\.xml|rss\\.xml|digests/rss\\.xml|og/|manifest\\.webmanifest|sw\\.js|favicon-32\\.png|apple-touch-icon\\.png|jpdev-).*)",
      "destination": "/index.html"
    }
  ]
}
