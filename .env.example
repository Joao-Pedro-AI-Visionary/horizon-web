# Copy to .env (git-ignored) only if you need to override the defaults.
#
# Where the horizon-go API (https://github.com/Joao-Pedro-AI-Visionary/horizon-go)
# is running. The Vite dev server (npm run dev, :5173) and preview server
# (npm run preview, :4173) proxy /api and /healthz to it. Also used by the
# Playwright configs to check that the backend is up.
HORIZON_API_URL=http://localhost:8080

# Optional: call the API directly from the browser instead of through the
# proxy (e.g. a static build served from another host). Baked in at build time.
# Leave empty to keep relative /api URLs. When set, the backend must allow this
# front's origin in HORIZON_CORS_ORIGINS.
VITE_API_URL=
